DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tournament_manager"
# Optional: customize host port if 5432 is in use by another service on your machine (e.g. on Windows)
# POSTGRES_PORT=5432

# System Admin Emergency Recovery PIN
SYSTEM_ADMIN_RECOVERY_PIN=""

# AES-256-GCM Encryption Key for storing tournament PINs at rest
PIN_ENCRYPTION_KEY="dev-secret-key-change-in-production-32b"

# Optional: send every Discord announcement and webhook test to this test-channel webhook instead of
# the tournament or organization webhook. Set it for Vercel Preview; leave it unset in Production.
# DISCORD_WEBHOOK_OVERRIDE_URL="https://discord.com/api/webhooks/<id>/<token>"
